---
import Base from '../layouts/Base.astro';import {getCollection} from 'astro:content';import {sortEvents,eventOwner} from '../lib/content';import {ui,formatDate,scopeText,type Lang} from '../lib/i18n';
const {lang='pt'}=Astro.props as {lang?:Lang};const t=ui[lang];const events=(await getCollection('events')).sort(sortEvents);const scopes=['All','ISEL NewSpace','ISEL group','Lisbon & regional','Portugal','Europe & international'];
---
<Base lang={lang} title={t.eventsTitle}><section class="subhero"><div class="wrap"><div class="eyebrow">{t.eyebrowEvents}</div><h1>{t.eventsTitle}</h1><p>{t.eventsIntro}</p></div></section><section class="section wrap"><div class="filters" id="filters">{scopes.map((s,i)=><button type="button" class={i===0?'active':''} data-scope={s}>{t.filters[i]}</button>)}</div><div id="eventlist">{events.map(e=><article class="event-row" data-scope={e.data.scope}><div class="datebox">{formatDate(e.data.date,lang)}</div><div><span class="pill">{scopeText(e.data.scope,lang)}</span><h3>{e.data.title}</h3><p>{e.data.summary}</p><p>{e.data.location} · {eventOwner(e)} {e.data.url&&<a class="text-link" href={e.data.url} target="_blank" rel="noopener">↗</a>}</p></div></article>)}</div></section><script>document.querySelectorAll<HTMLButtonElement>('#filters button').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('#filters button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');document.querySelectorAll<HTMLElement>('#eventlist [data-scope]').forEach(row=>row.classList.toggle('hidden',btn.dataset.scope!=='All'&&row.dataset.scope!==btn.dataset.scope));}));</script></Base>
