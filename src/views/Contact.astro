---
import Base from '../layouts/Base.astro';import {getCollection} from 'astro:content';import {groupSlug} from '../lib/content';import {ui,path,type Lang} from '../lib/i18n';
const {lang='pt'}=Astro.props as {lang?:Lang};const t=ui[lang];const groups=(await getCollection('teams')).sort((a,b)=>a.data.order-b.data.order);
---
<Base lang={lang} title={t.contactTitle}><section class="subhero"><div class="wrap"><div class="eyebrow">{t.contactEyebrow}</div><h1>{t.contactTitle}</h1><p>{t.contactIntro}</p></div></section><section class="section wrap"><div class="contact-grid"><article class="contact-panel"><div class="eyebrow">{t.location}</div><h2>ISEL · Lisboa</h2><p>{t.locationBody}</p><a class="text-link" href="https://www.isel.pt/" target="_blank" rel="noopener">{t.locationLink} ↗</a><div class="location-code">38.756°N, 9.116°W <span>·</span> LISBOA / PORTUGAL</div></article><article class="contact-panel"><div class="eyebrow">{t.groups}</div><h2>{t.groups}</h2><p>{t.contactInfo}</p><div class="contact-links">{groups.map(g=><a href={path(lang,`teams/${groupSlug(g)}/`)}>{g.data.title} ↗</a>)}</div></article></div></section></Base>
