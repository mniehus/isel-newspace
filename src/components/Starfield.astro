---
// Original starfield background. No remote assets, libraries or external requests.
---
<canvas class="starfield-canvas" aria-hidden="true" data-starfield></canvas>
<div class="sky-controls" aria-label="Observação do céu / Sky observation">
  <button class="sky-toggle" type="button" aria-expanded="false" aria-controls="sky-options">✦ <span>CEU / SKY</span> <span aria-hidden="true">⚙</span></button>
  <div id="sky-options" class="sky-options" hidden>
    <label for="bortle-input">Bortle <output id="bortle-output">4</output><input id="bortle-input" type="range" min="1" max="9" value="4" step="1" /></label>
    <label for="fov-input">FOV / campo de visão <output id="fov-output">75°</output><input id="fov-input" type="range" min="30" max="120" value="75" step="5" /></label>
    <small>Simulação visual ilustrativa · não fotométrica / illustrative, not photometric</small>
  </div>
</div>
<script>
  const SETTINGS = {
    // Adjust appearance and frequency here. All motion is decorative, not orbital data.
    starsPerPixel: 0.00070,
    maximumStars: 1400,
    driftPxPerSecond: 1.25,
    twinkleStrength: 0.53,
    meteorIntervalSeconds: [17, 38],
    meteorDurationSeconds: 0.8,
    satelliteFirstPassSeconds: [7, 14],
    satelliteIntervalSeconds: [25, 52],
    satelliteDurationSeconds: [12, 21],
    satelliteShapeProbability: 0.18,
    // Passes stay primarily in the clear sky on the right.
    satelliteZone: {left: -0.04, right: 1.04, top: 0.06, bottom: 0.78}
  };
  type Star = {x:number;y:number;r:number;alpha:number;phase:number;speed:number;depth:number;warm:boolean};
  type Meteor = {age:number;x:number;y:number;vx:number;vy:number};
  type Satellite = {age:number;duration:number;y0:number;y1:number;curve:number;fromRight:boolean;shape:boolean};
  function initialize(canvas:HTMLCanvasElement) {
    if(canvas.dataset.active==='true')return;
    canvas.dataset.active='true';
    const ctx=canvas.getContext('2d',{alpha:true});
    if(!ctx)return;
    const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
    const random=(a:number,b:number)=>a+Math.random()*(b-a);
    const interval=(range:number[])=>random(range[0],range[1]);
    let w=1,h=1,stars:Star[]=[],elapsed=0,last=0,frame=0,running=false;
    let bortle=4,fieldOfView=75;
    let meteor:Meteor|null=null,satellite:Satellite|null=null;
    let nextMeteor=interval(SETTINGS.meteorIntervalSeconds);
    let nextSatellite=interval(SETTINGS.satelliteFirstPassSeconds);
    const resize=()=>{
      const bounds=canvas.getBoundingClientRect();
      w=Math.max(1,bounds.width);h=Math.max(1,bounds.height);
      const dpr=Math.min(window.devicePixelRatio||1,2);
      canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);
      ctx.setTransform(dpr,0,0,dpr,0,0);
      const amount=Math.min(SETTINGS.maximumStars,Math.round(w*h*SETTINGS.starsPerPixel * (75/fieldOfView)));
      stars=Array.from({length:amount},()=>{
        const luminous=Math.random()<.095;
        return {x:random(0,w),y:random(0,h),r:luminous?random(1.15,1.9):random(.35,1.05),
          alpha:luminous?random(.68,.97):random(.32,.77),phase:random(0,6.283),
          speed:random(.2,.8),depth:random(.3,1),warm:Math.random()<.13};
      });
      draw();
    };
    function drawSatellite(s:Satellite){
      const p=Math.min(1,s.age/s.duration),z=SETTINGS.satelliteZone;
      const start=(s.fromRight?z.right:z.left)*w,end=(s.fromRight?z.left:z.right)*w;
      const x=start+(end-start)*p;
      const y=h*(s.y0+(s.y1-s.y0)*p)-s.curve*Math.sin(Math.PI*p);
      const opacity=Math.max(0,Math.min(1,p*9,(1-p)*9));
      ctx!.save();ctx!.translate(x,y);ctx!.globalAlpha=opacity;
      if(s.shape){
        ctx!.rotate((s.fromRight?-1:1)*.12);
        ctx!.strokeStyle='#c4e1f2';ctx!.lineWidth=.85;
        ctx!.fillStyle='#305b7a';
        ctx!.fillRect(-10,-2.7,7,5.4);ctx!.strokeRect(-10,-2.7,7,5.4);
        ctx!.fillRect(3,-2.7,7,5.4);ctx!.strokeRect(3,-2.7,7,5.4);
        ctx!.fillStyle='#e2f3fb';ctx!.fillRect(-2.5,-3.2,5,6.4);
      }else{
        const glow=ctx!.createRadialGradient(0,0,0,0,0,10);
        glow.addColorStop(0,'rgba(222,243,255,.46)');glow.addColorStop(1,'rgba(222,243,255,0)');
        ctx!.fillStyle=glow;ctx!.beginPath();ctx!.arc(0,0,10,0,6.283);ctx!.fill();
        ctx!.fillStyle='#effaff';ctx!.beginPath();ctx!.arc(0,0,1.75,0,6.283);ctx!.fill();
      }
      ctx!.restore();
    }
    function draw(){
      ctx!.clearRect(0,0,w,h);
      for(const s of stars){
        const x=(s.x+elapsed*SETTINGS.driftPxPerSecond*s.depth*(75/fieldOfView))%w;
        const y=(s.y-elapsed*SETTINGS.driftPxPerSecond*.12*s.depth+h)%h;
        // Lower Bortle class => fainter stars become visible. Visual illustration only.
        const visibility=(10-bortle)/9;
        const scaled=(s.alpha-.26)*1.10 + visibility*.40;
        const a=Math.max(0,Math.min(1,scaled))*(1-SETTINGS.twinkleStrength+SETTINGS.twinkleStrength*(.5+.5*Math.sin(elapsed*s.speed+s.phase)));
        ctx!.beginPath();ctx!.fillStyle=s.warm?`rgba(255,238,225,${a})`:`rgba(215,236,255,${a})`;
        ctx!.arc(x,y,s.r,0,6.283);ctx!.fill();
      }
      if(meteor){
        const p=meteor.age/SETTINGS.meteorDurationSeconds;
        const x=meteor.x+meteor.vx*meteor.age,y=meteor.y+meteor.vy*meteor.age;
        const tail=110,spd=Math.hypot(meteor.vx,meteor.vy);
        const tx=x-tail*meteor.vx/spd,ty=y-tail*meteor.vy/spd;
        const g=ctx!.createLinearGradient(tx,ty,x,y);
        g.addColorStop(0,'rgba(170,219,251,0)');
        g.addColorStop(1,`rgba(237,250,255,${.68*Math.max(0,Math.sin(Math.PI*p))})`);
        ctx!.strokeStyle=g;ctx!.lineWidth=1.3;ctx!.beginPath();ctx!.moveTo(tx,ty);ctx!.lineTo(x,y);ctx!.stroke();
      }
      if(satellite)drawSatellite(satellite);
    }
    function tick(now:number){
      if(!running)return;
      const dt=Math.min(.075,Math.max(0,(now-last)/1000));last=now;elapsed+=dt;
      if(meteor){meteor.age+=dt;if(meteor.age>=SETTINGS.meteorDurationSeconds)meteor=null}
      if(satellite){satellite.age+=dt;if(satellite.age>=satellite.duration)satellite=null}
      nextMeteor-=dt;nextSatellite-=dt;
      if(!satellite&&!meteor&&nextSatellite<=0){
        const z=SETTINGS.satelliteZone;
        satellite={age:0,duration:interval(SETTINGS.satelliteDurationSeconds),
          y0:random(z.top,z.bottom-.10),y1:random(z.top+.03,z.bottom),
          curve:random(-14,20),shape:Math.random()<SETTINGS.satelliteShapeProbability,
          fromRight:Math.random()<.5};
        nextSatellite=interval(SETTINGS.satelliteIntervalSeconds);
      }else if(!satellite&&!meteor&&nextMeteor<=0){
        meteor={age:0,x:random(w*.62,w*.94),y:random(h*.08,h*.34),vx:-255,vy:120};
        nextMeteor=interval(SETTINGS.meteorIntervalSeconds);
      }
      draw();frame=requestAnimationFrame(tick);
    }
    function stop(){running=false;cancelAnimationFrame(frame);draw()}
    function start(){if(running||motion.matches||document.hidden)return;running=true;last=performance.now();frame=requestAnimationFrame(tick)}
    function refresh(){if(motion.matches||document.hidden)stop();else start()}
    const observer=new ResizeObserver(resize);observer.observe(canvas);
    motion.addEventListener('change',refresh);document.addEventListener('visibilitychange',refresh);
    const wrapper=canvas.parentElement;
    const bortleInput=wrapper?.querySelector<HTMLInputElement>('#bortle-input');
    const fovInput=wrapper?.querySelector<HTMLInputElement>('#fov-input');
    bortleInput?.addEventListener('input',()=>{bortle=Number(bortleInput.value);const o=wrapper?.querySelector('#bortle-output');if(o)o.textContent=String(bortle);draw()});
    fovInput?.addEventListener('input',()=>{fieldOfView=Number(fovInput.value);const o=wrapper?.querySelector('#fov-output');if(o)o.textContent=fieldOfView+'°';resize()});
    const toggle=wrapper?.querySelector<HTMLButtonElement>('.sky-toggle');
    const panel=wrapper?.querySelector<HTMLElement>('.sky-options');
    toggle?.addEventListener('click',()=>{if(!panel)return;panel.hidden=!panel.hidden;toggle.setAttribute('aria-expanded',String(!panel.hidden));});
    resize();refresh();
  }
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-starfield]').forEach(initialize);
</script>
<style>
  .starfield-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:1}

  .sky-controls{position:fixed;bottom:15px;left:15px;z-index:10;font-family:ui-monospace,monospace;font-size:12px;color:#e0f5ff}
  .sky-toggle{background:rgba(4,19,34,.88);border:1px solid #4882a5;color:#bce7f8;padding:9px 12px;cursor:pointer;border-radius:5px;letter-spacing:.04em;font-size:12px}
  .sky-toggle:focus-visible,.sky-options input:focus-visible{outline:2px solid #9defff;outline-offset:3px}
  .sky-options{background:rgba(4,19,34,.95);border:1px solid #4882a5;border-radius:5px;margin-top:6px;padding:15px;width:270px;box-shadow:0 8px 22px #0008;backdrop-filter:blur(12px)}
  .sky-options[hidden]{display:none}
  .sky-options label{display:block;margin:0 0 13px;font-size:12px}
  .sky-options input{width:100%;display:block;margin-top:9px;accent-color:#68daf5}
  .sky-options output{float:right;font-weight:bold;color:#8bdffa}
  .sky-options small{color:#99b9ca;font-size:10px;line-height:1.4;display:block}
  @media(prefers-reduced-motion:reduce){.sky-controls{opacity:.9}}
</style>
